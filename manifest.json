{
  "manifest_version": 3,
  "name": "Site Dossier",
  "version": "0.2.3",
  "description": "Collect websites, images and screenshots with notes and tags in a local reference folder for you and your agents.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "storage",
    "notifications",
    "sidePanel",
    "contextMenus"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/banner.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Site Dossier",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
